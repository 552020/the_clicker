# ===========================================
# Environment Variables for The Clicker DApp
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ===========================================
# REQUIRED FOR DEPLOYMENT
# ===========================================

# Alchemy API Key - Required for blockchain interaction
# Get from: https://dashboard.alchemyapi.io
# 1. Create account
# 2. Create new app → Sepolia network
# 3. Copy the API key
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Deployer Private Key - Required for contract deployment
# Get from MetaMask:
# 1. MetaMask → Account details → Export private key
# 2. Enter password and copy the private key
# 3. Add 0x prefix if not present
# 
# ⚠️  SECURITY WARNING:
# - Use a dedicated dev account, NOT your main account
# - Safe for testnets (Sepolia, Goerli), NEVER for mainnet
# - Never commit this to git or share publicly
__RUNTIME_DEPLOYER_PRIVATE_KEY=your_private_key_here

# ===========================================
# OPTIONAL (for contract verification)
# ===========================================

# Etherscan API Key - Required for contract verification
# Get from: https://etherscan.io/apis
# 1. Create account on Etherscan
# 2. Go to API Keys section
# 3. Create new API key
# 
# Note: Optional for deployment, required for verification
ETHERSCAN_MAINNET_API_KEY=your_etherscan_api_key_here

# ===========================================
# OPTIONAL (for advanced features)
# ===========================================

# Enable mainnet forking for testing
# Set to "true" to fork mainnet for local testing
# Requires ALCHEMY_API_KEY with mainnet access
MAINNET_FORKING_ENABLED=false

# ===========================================
# DEPLOYMENT CHECKLIST
# ===========================================
# Before deploying to Sepolia:
# 
# ✅ [ ] Got Alchemy API key
# ✅ [ ] Got MetaMask dev account private key
# ✅ [ ] Got Sepolia testnet ETH (from faucet)
# ✅ [ ] Filled in ALCHEMY_API_KEY
# ✅ [ ] Filled in __RUNTIME_DEPLOYER_PRIVATE_KEY
# ✅ [ ] (Optional) Got Etherscan API key for verification
#
# Deployment commands:
# yarn deploy --network sepolia
# yarn verify --network sepolia (after deployment)